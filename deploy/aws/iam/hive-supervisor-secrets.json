{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAgentAndTeamSecrets",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter"],
      "Resource": [
        "arn:aws:ssm:*:*:parameter/buzz/agents/*/env/*",
        "arn:aws:ssm:*:*:parameter/buzz/team/env/*"
      ]
    }
  ]
}
