# syntax=docker/dockerfile:1.7
# Beehive service image. Build from the repo root:
#   docker build -f deploy/aws/Dockerfile.hive -t buzz-hive:local .
# The image also carries buzz-hive-mcp, the stdio tool server an agent runs, and
# buzz-hive-supervisor, which the host copies out and runs as a systemd service
# (deploy/aws/buzz-hive-supervisor.service). The service never runs it in a container.
#
# Optional: the Beehive web page the phone's web view loads, served at /beehive/. Build the
# bundle in buzz-app first (output dist-beehive/), then pass it as a named build context:
#   docker build --build-context beehive-web=/path/to/dist-beehive \
#     -f deploy/aws/Dockerfile.hive -t buzz-hive:local .
# Without it the image builds as before, prints a skip line, and serves no page.
ARG RUST_VERSION=1.98
ARG DEBIAN_VERSION=bookworm

FROM rust:${RUST_VERSION}-${DEBIAN_VERSION} AS builder
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential cmake pkg-config libssl-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY . .
# The cache mounts keep downloaded crates and compiled dependencies between builds,
# so the binary is copied out of the mounted target directory in the same step.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/build/target \
    cargo build --release --locked -p buzz-hive --bin buzz-hive \
    && cargo build --release --locked -p buzz-hive-mcp --bin buzz-hive-mcp \
    && cargo build --release --locked -p buzz-hive-supervisor --bin buzz-hive-supervisor \
    && install -D -m 0755 target/release/buzz-hive /out/buzz-hive \
    && install -D -m 0755 target/release/buzz-hive-mcp /out/buzz-hive-mcp \
    && install -D -m 0755 target/release/buzz-hive-supervisor /out/buzz-hive-supervisor \
    && strip /out/buzz-hive /out/buzz-hive-mcp /out/buzz-hive-supervisor

# Empty unless --build-context beehive-web=<dir> replaces it with the built page.
FROM scratch AS beehive-web

FROM debian:${DEBIAN_VERSION}-slim AS runtime
LABEL org.opencontainers.image.title="Buzz Hive" \
      org.opencontainers.image.description="Beehive workflow engine service for Buzz" \
      org.opencontainers.image.source="https://github.com/block/buzz" \
      org.opencontainers.image.licenses="Apache-2.0"
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 1000 buzz \
    && useradd --system --uid 1000 --gid 1000 --home-dir /var/lib/buzz --create-home --shell /usr/sbin/nologin buzz
COPY --from=builder /out/buzz-hive /usr/local/bin/buzz-hive
COPY --from=builder /out/buzz-hive-mcp /usr/local/bin/buzz-hive-mcp
COPY --from=builder /out/buzz-hive-supervisor /usr/local/bin/buzz-hive-supervisor
COPY --from=beehive-web --chmod=a+rX,go-w / /opt/buzz/beehive-web/
RUN if [ -f /opt/buzz/beehive-web/index.html ]; then \
      echo "beehive-web: bundle copied to /opt/buzz/beehive-web"; \
    else \
      echo "beehive-web: skipped, no --build-context beehive-web=<dir> given; the image serves no Beehive page"; \
    fi
# The service serves the page only when this folder holds an index.html.
ENV BUZZ_HIVE_WEB_DIR=/opt/buzz/beehive-web
EXPOSE 3100
USER buzz:buzz
WORKDIR /var/lib/buzz
ENTRYPOINT ["/usr/local/bin/buzz-hive"]
