# syntax=docker/dockerfile:1.7
# Agent image: the Buzz tools from the sprig image plus the Claude Code and
# Codex adapters, on Debian because the adapters ship glibc binaries.
# Build from the repo root with the sprig image already built:
#   docker build -f deploy/aws/Dockerfile.agents --build-arg SPRIG_IMAGE=<sprig image> .
ARG SPRIG_IMAGE
FROM ${SPRIG_IMAGE} AS sprig

FROM node:22-bookworm-slim

# Adapter versions are pinned so a rebuild cannot change how MCP config loads.
# tests/aws/test-agents-mcp.sh is the check to run when raising them.
ARG CLAUDE_ACP_VERSION=0.93.0
ARG CODEX_ACP_VERSION=2.2.2

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g \
         "@agentclientprotocol/claude-agent-acp@${CLAUDE_ACP_VERSION}" \
         "@agentclientprotocol/codex-acp@${CODEX_ACP_VERSION}" \
    && useradd --create-home --home-dir /home/agent --shell /bin/bash agent \
    && install -d -o agent -g agent /workspace /home/agent

COPY --from=sprig --chmod=0755 /usr/local/bin/sprig /usr/local/bin/sprig
COPY --chmod=0755 scripts/sprig-entrypoint.sh /usr/local/bin/sprig-entrypoint
COPY --chmod=0755 deploy/aws/agent-entrypoint.sh /usr/local/bin/agent-entrypoint
RUN for name in \
      buzz-acp buzz-agent buzz-dev-mcp rg tree buzz \
      git-credential-nostr git-sign-nostr; do \
        ln -s sprig "/usr/local/bin/$name"; \
    done

ENV HOME=/home/agent
WORKDIR /home/agent
USER agent
ENTRYPOINT ["/usr/local/bin/agent-entrypoint"]
